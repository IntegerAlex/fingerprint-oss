{
  "name": "fingerprint-oss",
  "version": "0.12.0",
  "description": "A comprehensive JavaScript library for device fingerprinting and system information collection. Provides robust, deterministic fingerprinting for web applications with privacy-conscious design.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "unpkg": "dist/index.min.js",
  "jsdelivr": "dist/index.min.js",
  "scripts": {
    "build": "rollup -c && node scripts/postbuild.mjs",
    "rollup": "rollup -c",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack .",
    "check:size": "node scripts/check-size.mjs",
    "audit": "npm audit",
    "docs": "typedoc",
    "test": "cd test && npm run test:unit",
    "test:all": "cd test && npm run test:all",
    "test:unit": "cd test && npm run test:unit",
    "test:e2e": "cd test && npm run test:e2e",
    "test:automation": "cd test/automation && node run.mjs",
    "prepublishOnly": "npm run build"
  },
  "author": "Akshat Kotpalliwar (alias IntegerAlex on GitHub)",
  "files": [
    "dist/**",
    "LICENSE",
    "NOTICE.md",
    "COPYRIGHT.md",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "fingerprinting",
    "device-fingerprint",
    "browser-fingerprint",
    "system-info",
    "user-agent",
    "canvas-fingerprint",
    "webgl-fingerprint",
    "audio-fingerprint",
    "font-detection",
    "privacy",
    "security",
    "web-analytics",
    "device-detection",
    "tracking",
    "identification"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/IntegerAlex"
  },
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IntegerAlex/fingerprint-oss.git"
  },
  "bugs": {
    "url": "https://github.com/IntegerAlex/fingerprint-oss/issues"
  },
  "homepage": "https://github.com/IntegerAlex/fingerprint-oss#readme",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "express": "^4.18.2",
    "publint": "^0.3.25",
    "rollup": "^4.35.0",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@fingerprintjs/botd": "^2.0.0",
    "bowser": "^2.15.1",
    "hash-wasm": "^4.12.0",
    "isbot": "^5.2.3"
  },
  "overrides": {
    "fast-xml-builder": "^1.1.7",
    "fast-xml-parser": "^5.7.0",
    "postcss": "^8.5.10",
    "minimatch": "^3.1.4",
    "svgo": "^3.3.3",
    "path-to-regexp": "^0.1.13",
    "picomatch": "^2.3.2",
    "lodash": "^4.18.0",
    "fast-uri": "^3.1.2",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "brace-expansion": "^1.1.13",
    "follow-redirects": "^1.16.0",
    "qs": "^6.15.2",
    "esbuild": "^0.28.1",
    "ajv@<6.14.0": "^6.14.0",
    "ajv@>=7.0.0 <8.18.0": "^8.18.0"
  }
}
