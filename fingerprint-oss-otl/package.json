{
  "name": "telemetry-server",
  "version": "0.1.0",
  "private": true,
  "deprecated": "This package is deprecated. fingerprint-oss deprecated built-in telemetry in v0.10.1, so this standalone OTL server has no consumer and is no longer maintained. Do not use in new projects.",
  "description": "DEPRECATED: standalone OpenTelemetry OTLP receiver/storage server for fingerprint-oss (telemetry was removed from fingerprint-oss in v0.10.1)",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/otlp-transformer": "^0.52.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "helmet": "^7.2.0",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^2.0.16",
    "eslint": "^9.39.5",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
